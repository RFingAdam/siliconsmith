snapshot_edits:
  # Edits made to the snapshot file itself (the hash below is of the edited file).
  - file: test/requirements.txt
    change: >-
      'pytest==8.4.2' becomes 'pytest==9.2.0': 8.4.2 has a tmpdir advisory
      (GHSA-6w46-j5rx-g56g, fixed in 9.0.3), and 9.2.0 is the pytest the toolchain image runs.
    upstream_sha256: c1ba8e1b931e68c3ff600bb849f20975435fedbb7e5f83932095a05d2dca1372

patches:
  # Two of our stubs are adapted from upstream files and keep the Tiny Tapeout copyright line:
  # stubs/verilog.v.tmpl (from src/project.v) and stubs/test.py.tmpl (from test/test.py).
  # Everything else the scaffold does is generate our own files from our own stubs.
  - file: info.yaml
    change: >-
      Loaded with yaml.safe_load and written back with yaml.safe_dump (comments are lost).
      Fields set: project.title, project.author, project.description, project.language,
      project.top_module (tt_um_<name>), project.source_files ([project.v, <name>.v]),
      project.tiles (1x1). All other values are kept.
  - file: test/tb.v
    change: "The instance line 'tt_um_example user_project (' becomes 'tt_um_<name> user_project ('."
  - file: test/Makefile
    change: "'PROJECT_SOURCES = project.v' becomes 'PROJECT_SOURCES = project.v <name>.v'."

