"""{name}: the core of this chip, written in Amaranth.

This starter copies the Tiny Tapeout example: `uo_out` is `ui_in + uio_in`, computed
combinationally. Replace `elaborate` with your own design. Keep the pin names: they are the
Tiny Tapeout pins, and the generated `tt_um_{name}` wrapper connects them by name.

Pin summary (a design may use any subset):
  inputs   clk, rst_n (active low), ena, ui_in[7:0], uio_in[7:0]
  outputs  uo_out[7:0], uio_out[7:0], uio_oe[7:0]
"""

from amaranth.hdl import ClockDomain, Module
from amaranth.lib import wiring
from amaranth.lib.wiring import In, Out


class Core(wiring.Component):
    ui_in: In(8)
    uo_out: Out(8)
    uio_in: In(8)
    uio_out: Out(8)
    uio_oe: Out(8)
    ena: In(1)
    clk: In(1)
    rst_n: In(1)

    def elaborate(self, platform):
        m = Module()

        # Tiny Tapeout gives you a clock and an active-low reset, but Amaranth's default reset
        # is active-high. So this design makes its own "sync" clock domain from those pins.
        # Registers you write with m.d.sync use it. This starter has none yet.
        m.domains.sync = cd = ClockDomain("sync")
        m.d.comb += [cd.clk.eq(self.clk), cd.rst.eq(~self.rst_n)]

        m.d.comb += [
            self.uo_out.eq(self.ui_in + self.uio_in),
            self.uio_out.eq(0),
            self.uio_oe.eq(0),  # 0 = every bidirectional pin is an input
        ]
        return m


def top() -> wiring.Component:
    """Entry point that Siliconsmith calls to build the design."""
    return Core()
